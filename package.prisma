#prisma 4.0
def package "luce-png" {
    str owner = "dymokomi"
    str version = "0.1.1"
    str kind = "package"
    str language = "luce-base"
    str description = "A PNG decoder and encoder for Luce/Base."
    str readme = "README.md"

    def dependency "luce-raster" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-raster"
    }

    def dependency "luce-compress" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-compress"
    }

    def export "png" {
        str module = "luce_png.png"
    }
}
